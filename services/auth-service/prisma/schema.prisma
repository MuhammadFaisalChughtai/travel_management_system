// Auth Service Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-auth"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformAdmin {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  encryptedPassword  String
  name               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Tenant {
  id                 Int       @id @default(autoincrement())
  name               String
  domain             String?   @unique
  status             String    @default("active")
  logo               String?
  description        String?
  industry           String?
  location           String?
  email              String?
  phone              String?
  subscriptionPlan   String    @default("trial")
  subscriptionStatus String    @default("trial")
  stripeCustomerId   String?
  trialEndsAt        DateTime?
  smtpHost           String?   @db.VarChar(255)
  smtpPort           Int?
  smtpSecure         Boolean?  @default(false)
  smtpUser           String?   @db.VarChar(255)
  smtpPass           String?   @db.VarChar(255)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  users              User[]
  roles              Role[]
}

model User {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  email              String    @unique
  encryptedPassword  String
  resetPasswordToken String?   @unique
  resetPasswordSentAt DateTime?
  rememberCreatedAt  DateTime?
  name               String?
  roleId             Int?
  agentId            Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role               Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  agent              Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Role {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Agent {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String   @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phoneNumber String?  @db.VarChar(50)
  gdsSystem   String?  @db.VarChar(100)
  client      String?  @db.VarChar(255)
  pcc         String?  @db.VarChar(100)
  jobStatus   String   @default("Active") @db.VarChar(50)
  basicSalary Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  marginSegments AgentMarginSegment[]
  wallet         AgentWallet?
  users          User[]
  attendance     AgentAttendance[]
  payrolls       AgentPayroll[]
}

model AgentMarginSegment {
  id            Int      @id @default(autoincrement())
  agentId       Int
  minAmount     Decimal  @db.Decimal(12, 2)
  maxAmount     Decimal? @db.Decimal(12, 2)
  marginPercent Decimal  @db.Decimal(5, 2)
  label         String?  @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Vendor {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  name          String   @db.VarChar(255)
  phoneNumber   String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  website       String?  @db.VarChar(255)
  vendorType    String?  @db.VarChar(100)
  creditBalance Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
}

model AgentWallet {
  id             Int      @id @default(autoincrement())
  agentId        Int      @unique
  currentBalance Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt      DateTime @updatedAt

  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  transactions   AgentTransaction[]
}

model AgentTransaction {
  id              Int      @id @default(autoincrement())
  agentWalletId   Int
  amount          Decimal  @db.Decimal(10, 2)
  transactionType String   @db.VarChar(50)
  referenceId     String?  @db.VarChar(100)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  wallet          AgentWallet @relation(fields: [agentWalletId], references: [id], onDelete: Cascade)
}

model DemoRequest {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String
  companyName String
  phoneNumber String?
  agencySize  String?
  gdsSystems  String?
  message     String?  @db.Text
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentAttendance {
  id          Int       @id @default(autoincrement())
  agentId     Int
  tenantId    Int
  checkIn     DateTime
  checkOut    DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([checkIn])
}

model AgentPayroll {
  id                 Int       @id @default(autoincrement())
  agentId            Int
  tenantId           Int
  periodFrom         DateTime
  periodTo           DateTime
  basicSalary        Decimal   @default(0.00) @db.Decimal(10, 2)
  totalMarginEarned  Decimal   @default(0.00) @db.Decimal(10, 2)
  totalPaid          Decimal   @default(0.00) @db.Decimal(10, 2)
  status             String    @default("Draft") @db.VarChar(20)
  sentAt             DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([periodFrom])
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
