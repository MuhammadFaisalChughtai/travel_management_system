// Booking Service Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-booking"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  VISA
  TRANSPORT
  HOTEL
  FLIGHT
  OTHER
}

model ServiceCatalog {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  serviceType ServiceType
  name        String      @db.VarChar(255)
  unitPrice   Decimal     @db.Decimal(10, 2)
  currency    String?     @db.VarChar(10)
  metadata    Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Booking {
  id                  Int       @id @default(autoincrement())
  tenantId            Int
  bookingReference    String    @db.VarChar(50)
  date                DateTime  @db.Date
  departureDate       DateTime? @db.Date
  agentId             Int?      // External Reference
  agentName           String?   // Name of the agent who made the booking
  totalPrice          Decimal   @default(0.00) @db.Decimal(10, 2)
  paidAmount          Decimal   @default(0.00) @db.Decimal(10, 2)
  refundAmount        Decimal   @default(0.00) @db.Decimal(10, 2)
  cardPaymentCharges  Decimal   @default(0.00) @db.Decimal(10, 2)
  cancellationCharges Decimal   @default(0.00) @db.Decimal(10, 2)
  remainingAmount     Decimal   @default(0.00) @db.Decimal(10, 2)
  agentMargin         Decimal   @default(0.00) @db.Decimal(10, 2)
  marginStatus        String    @default("Pending") @db.VarChar(50)
  totalSent           Decimal   @default(0.00) @db.Decimal(10, 2)
  status              String    @default("confirmed") @db.VarChar(50)
  paymentStatus       String    @default("unpaid") @db.VarChar(50)
  isLocked            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customers           BookingCustomer[]
  payments            BookingPayment[]
  vendorPayments      VendorPayment[]
  accommodations      AccommodationService[]
  flightServices      FlightService[]
  transportServices   TransportService[]
  visaServices        VisaService[]
  discounts           BookingDiscount[]
  refunds             BookingRefund[]
  additionalServices  AdditionalService[]
  priceLogs           BookingPriceLog[]
  documentLogs        DocumentLog[]

  @@unique([tenantId, bookingReference])
}

model BookingCustomer {
  id                 Int       @id @default(autoincrement())
  tenantId           Int
  bookingId          Int
  customerId         Int?      // Optional if we want to save local passenger info
  title              String?   @db.VarChar(10)
  firstName          String    @db.VarChar(255)
  lastName           String    @db.VarChar(255)
  ageCategory        String    @default("Adult") @db.VarChar(50) // 'Adult', 'Child', 'Infant'
  email              String?   @db.VarChar(255)
  phoneNumber        String?   @db.VarChar(50)
  passportNumber     String?   @db.VarChar(255)
  passportExpiryDate DateTime? @db.Date
  dob                DateTime? @db.Date
  passportImage      String?   @db.Text
  agentName          String?   @db.VarChar(255)
  role               String?   @db.VarChar(50) // 'Leader', 'Family Member'
  nationality        String?   @db.VarChar(255)
  issuingCountry     String?   @db.VarChar(255)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  documents          PassengerDocument[]
}

model BookingPayment {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  bookingId     Int
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @db.VarChar(100) // e.g. bank_transfer
  paymentType   String   @db.VarChar(100) // e.g. instalment
  paidOn        DateTime @db.Date
  notes         String?  @db.Text
  status        String   @default("approved") @db.VarChar(50)
  evidenceUrl   String?  @db.Text
  loggedByRole  String?  @db.VarChar(50)
  loggedById    Int?
  loggedByName  String?  @db.VarChar(255)
  cardCharges   Decimal? @default(0.00) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model VendorPayment {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  bookingId         Int
  vendorId          Int?
  vendorName        String    @db.VarChar(255)
  amount            Decimal   @db.Decimal(10, 2)
  paymentStatus     String    @default("unpaid") @db.VarChar(50)
  paidOn            DateTime? @db.Date
  flightPnr         String?   @db.VarChar(100)
  issueDate         DateTime? @db.Date
  reservationNumber String?   @db.VarChar(100)
  notes             String?   @db.Text
  totalPaid         Decimal   @default(0.00) @db.Decimal(10, 2)
  totalRefunded     Decimal   @default(0.00) @db.Decimal(10, 2)
  remainingDue      Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AccommodationService {
  id                       Int       @id @default(autoincrement())
  tenantId                 Int
  bookingId                Int
  vendorId                 Int?
  vendorName               String    @db.VarChar(255)
  hotelName                String    @db.VarChar(255)
  city                     String?   @db.VarChar(255)
  roomType                 String?   @db.VarChar(100)
  checkInDate              DateTime? @db.Date
  checkOutDate             DateTime? @db.Date
  mealType                 String?   @db.VarChar(100)
  reservationNumber        String?   @db.VarChar(100)
  qty                      Int       @default(1)
  price                    Decimal   @default(0.00) @db.Decimal(10, 2)
  currency                 String?   @db.VarChar(10)
  otherCurrency            String?   @db.VarChar(10)
  conversionRate           Decimal?  @db.Decimal(10, 4)
  issueDate                DateTime? @db.Date
  refundAmount             Decimal   @default(0.00) @db.Decimal(10, 2)
  fineAmount               Decimal   @default(0.00) @db.Decimal(10, 2)
  hotelConfirmationNumber  String?   @db.VarChar(100)
  hotelAddress             String?   @db.Text
  lastCancellationDate     DateTime? @db.Date
  createdAt                DateTime  @default(now())
  isPaidToVendor    Boolean   @default(false)
  updatedAt                DateTime  @updatedAt

  booking                  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model FlightService {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  bookingId         Int
  date              DateTime? @db.Date
  vendorName        String    @db.VarChar(255)
  flightNo          String    @db.VarChar(100)
  pnr               String    @db.VarChar(50)
  departedFrom      String    @db.VarChar(255)
  arrivedAt         String    @db.VarChar(255)
  departTime        String?   @db.VarChar(50)
  arrivalTime       String?   @db.VarChar(50)
  qty               Int       @default(1)
  unitPrice         Decimal   @default(0.00) @db.Decimal(10, 2)
  price             Decimal   @default(0.00) @db.Decimal(10, 2)
  currency          String?   @db.VarChar(10)
  otherCurrency     String?   @db.VarChar(10)
  conversionRate    Decimal?  @db.Decimal(10, 4)
  issueDate         DateTime? @db.Date
  refundAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  fineAmount        Decimal   @default(0.00) @db.Decimal(10, 2)
  baggage           String?   @db.VarChar(255)
  carryOnBaggage    String?   @db.VarChar(255)
  checkedBaggage    String?   @db.VarChar(255)
  flightClass       String?   @db.VarChar(100)
  createdAt         DateTime  @default(now())
  isPaidToVendor    Boolean   @default(false)
  updatedAt         DateTime  @updatedAt

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model TransportService {
  id                    Int       @id @default(autoincrement())
  tenantId              Int
  bookingId             Int
  vendorName            String    @db.VarChar(255)
  vehicleType           String    @db.VarChar(255)
  departureDestination  String    @db.VarChar(255)
  arrivalDestination    String    @db.VarChar(255)
  date                  DateTime? @db.Date
  departureTime         String?   @db.VarChar(50)
  arrivalTime           String?   @db.VarChar(50)
  flightNo              String?   @db.VarChar(100)
  price                 Decimal   @default(0.00) @db.Decimal(10, 2)
  currency              String?   @db.VarChar(10)
  otherCurrency         String?   @db.VarChar(10)
  conversionRate        Decimal?  @db.Decimal(10, 4)
  issueDate             DateTime? @db.Date
  refundAmount          Decimal   @default(0.00) @db.Decimal(10, 2)
  fineAmount            Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime  @default(now())
  isPaidToVendor    Boolean   @default(false)
  updatedAt             DateTime  @updatedAt

  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model VisaService {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  bookingId         Int
  vendorName        String    @db.VarChar(255)
  passportNumber    String    @db.Text
  visaType          String    @db.VarChar(100)
  visaNumber        String?   @db.VarChar(100)
  issueDate         DateTime? @db.Date
  expiryDate        DateTime? @db.Date
  qty               Int       @default(1)
  unitPrice         Decimal   @default(0.00) @db.Decimal(10, 2)
  price             Decimal   @default(0.00) @db.Decimal(10, 2)
  currency          String?   @db.VarChar(10)
  otherCurrency     String?   @db.VarChar(10)
  conversionRate    Decimal?  @db.Decimal(10, 4)
  refundAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  fineAmount        Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  isPaidToVendor    Boolean   @default(false)
  updatedAt         DateTime  @updatedAt

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingDiscount {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  bookingId       Int
  vendorCategory  String   @db.VarChar(100) // e.g. Hotel, Flight, Visa
  serviceName     String?  @db.VarChar(255) // Specific service line item
  amount          Decimal  @db.Decimal(10, 2)
  notes           String?  @db.Text
  date            DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingRefund {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  bookingId       Int
  direction       String   @db.VarChar(50)  // 'Refund to Client' | 'Refund from Vendor'
  vendorCategory  String   @db.VarChar(100) // e.g. Hotel, Flight, Visa
  serviceName     String?  @db.VarChar(255) // Specific service line item
  amount          Decimal  @db.Decimal(10, 2)
  notes           String?  @db.Text
  date            DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AdditionalService {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  bookingId     Int
  serviceName   String   @db.VarChar(255)
  vendorName    String?  @db.VarChar(255)
  charges       Decimal  @default(0.00) @db.Decimal(10, 2)
  currency      String?  @db.VarChar(10)
  otherCurrency String?  @db.VarChar(10)
  conversionRate Decimal? @db.Decimal(10, 4)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  isPaidToVendor    Boolean   @default(false)
  updatedAt     DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// FINANCE AND LEDGER SYSTEM

model LedgerAccount {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  accountType String   @db.VarChar(50) // "VENDOR_PAYABLE", "CUSTOMER_RECEIVABLE", "BANK", "REVENUE"
  entityId    Int?     // e.g., Vendor ID or Agent ID
  entityName  String?  @db.VarChar(255)
  balance     Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  transactions LedgerEntry[]
}

model LedgerTransaction {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  transactionDate DateTime @db.Date
  referenceNumber String?  @db.VarChar(100) // PNR, Ticket Number, Invoice Number
  description     String   @db.Text
  type            String   @db.VarChar(50) // "PAYMENT", "INVOICE", "REFUND", "CREDIT"
  createdAt       DateTime @default(now())
  
  entries         LedgerEntry[]
  allocations     BookingAllocation[]
}

model LedgerEntry {
  id              Int      @id @default(autoincrement())
  transactionId   Int
  accountId       Int
  debitAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  creditAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account         LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model BookingAllocation {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  transactionId   Int
  bookingId       Int
  serviceType     String   @db.VarChar(50) // "FLIGHT", "HOTEL", etc.
  serviceId       Int      // ID of the specific service record
  allocatedAmount Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Notification {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  title       String   @db.VarChar(255)
  message     String   @db.Text
  type        String   @db.VarChar(50) // e.g. "PAYMENT_APPROVAL"
  referenceId String?  @db.VarChar(100) // bookingPayment ID or Booking ID
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookingPriceLog {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  bookingId       Int
  serviceType     String   @db.VarChar(100) // e.g. 'Flight', 'Accommodation', 'Transport', 'Visa', 'Additional'
  serviceName     String   @db.VarChar(255) // e.g. 'EgyptAir - MS780', 'Hilton'
  action          String   @db.VarChar(50)  // 'ADD' | 'UPDATE'
  oldPrice        Decimal  @db.Decimal(10, 2)
  newPrice        Decimal  @db.Decimal(10, 2)
  loggedByName    String   @db.VarChar(255)
  loggedById      Int?
  createdAt       DateTime @default(now())

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model CompanyContext {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @unique
  companyName     String   @db.VarChar(255)
  logoPrimary     String?  @db.Text
  logoSecondary   String?  @db.Text
  officeAddress   String?  @db.Text
  emailSender     String?  @db.VarChar(255)
  landlineFormat  String?  @db.VarChar(100)
  whatsappWebhook String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DocumentTemplate {
  id            Int                @id @default(autoincrement())
  tenantId      Int
  name          String             @db.VarChar(255)
  type          String             @db.VarChar(50) // e.g. "INVOICE", "VOUCHER"
  version       Int                @default(1)
  status        String             @default("Draft") // "Draft", "Active", "Deprecated"
  structureHtml String             @db.Text
  structureCss  String             @db.Text
  variables     TemplateVariable[]
  logs          DocumentLog[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([tenantId, name, version])
}

model TemplateVariable {
  id           Int              @id @default(autoincrement())
  templateId   Int
  token        String           @db.VarChar(100) // e.g. "company.name"
  description  String?          @db.VarChar(255)
  pathInRecord String           @db.VarChar(255) // e.g. "bookingReference"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, token])
}

model DocumentLog {
  id               Int              @id @default(autoincrement())
  tenantId         Int
  templateId       Int
  bookingId        Int
  referenceNumber  String           @db.VarChar(100)
  documentType     String           @db.VarChar(50)
  recipientName    String           @db.VarChar(255)
  amountGross      Decimal          @db.Decimal(10, 2)
  amountSettled    Decimal          @db.Decimal(10, 2)
  amountDue        Decimal          @db.Decimal(10, 2)
  digitalSignature String           @db.Text
  metadataJson     String           @db.Text
  createdAt        DateTime         @default(now())

  template         DocumentTemplate @relation(fields: [templateId], references: [id])
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Expense {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String   @db.VarChar(255)
  amount    Decimal  @db.Decimal(10, 2)
  type      String   @db.VarChar(50) // "one-time" | "recurring"
  date      DateTime @db.Date         // Date of occurrence or recurring start date
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PassengerDocument {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  passengerId Int
  title       String   @db.VarChar(255)
  description String?  @db.Text
  fileUrl     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  passenger   BookingCustomer @relation(fields: [passengerId], references: [id], onDelete: Cascade)
}



