// Flight Service Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  name         String
  contactEmail String?
  contactPhone String?   @db.VarChar(50)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  flights      FlightService[]
}

model FlightService {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  bookingId       Int       // External Reference
  vendorId        Int
  customerId      Int?      // External Reference
  date            DateTime? @db.Date
  flightNo        String    @db.VarChar(100)
  pnr             String?   @db.VarChar(50)
  departedFrom    String?
  arrivedAt       String?
  departTime      String?   @db.VarChar(50)
  arrivalTime     String?   @db.VarChar(50)
  price           Decimal   @default(0.00) @db.Decimal(10, 2)
  currency        String?   @db.VarChar(10)
  issueDate       DateTime? @db.Date
  refundAmount    Decimal   @default(0.00) @db.Decimal(10, 2)
  fineAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  baggage         String?   @db.VarChar(50)
  carryOnBaggage  String?   @db.VarChar(50)
  checkedBaggage  String?   @db.VarChar(50)
  flightClass     String?   @db.VarChar(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([tenantId, pnr])
}
